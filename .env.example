# AML Evidence Anchor Environment Configuration Template
PORT=8000
E2MEM_HOST=0.0.0.0
E2MEM_MODE=competition
E2MEM_DB=data/memory.sqlite3

# Optional: Set authentication key required by AML evaluation platform
# Supports Bearer, Token, or X-Api-Key headers
MEMORY_SYSTEM_KEY=

# LLM & Embedding Model Credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
E2MEM_CHAT_MODEL=gpt-4o-mini
E2MEM_EMBEDDING_MODEL=text-embedding-v4
E2MEM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
E2MEM_EMBEDDING_API_KEY=

# Privacy Redaction & Trace Logging
E2MEM_REDACT=1
E2MEM_SEARCH_TRACE_FILE=/data/traces/search.jsonl
E2MEM_ADD_TRACE_FILE=/data/traces/add.jsonl

# Optional External Reranker (Disabled in competition configuration)
ENABLE_JEV=0
